-- Anti-Reset Version
local p = game:GetService("Players").LocalPlayer

local function applyEffects(char)
    if not char then return end
    
    local h = char:FindFirstChild("Head")
    if h then
        h.Transparency = 1
        local m = h:FindFirstChild("Mesh")
        if m then m:Destroy() end
    end
    
    local l = char:FindFirstChild("Right Leg")
    if l then
        l.Transparency = 1
        local kl = Instance.new("Part")
        kl.Name = "KorbloxLeg"
        kl.Size = l.Size
        kl.Anchored = false
        kl.CanCollide = false
        kl.Transparency = 0.1
        kl.Material = Enum.Material.SmoothPlastic
        kl.BrickColor = BrickColor.new("White")
        kl.Parent = char
        kl.CFrame = l.CFrame
        
        local w = Instance.new("Weld")
        w.Part0 = kl
        w.Part1 = l
        w.C0 = CFrame.new(0, 0, 0)
        w.Parent = kl
    end
end

-- Apply to current character
local c = p.Character
if c then applyEffects(c) end

-- Auto-apply on respawn
p.CharacterAdded:Connect(function(c)
    repeat task.wait() until c and c:FindFirstChild("Torso")
    task.wait(0.5)
    applyEffects(c)
end)

-- Keep applying (anti-remove)
game:GetService("RunService").Heartbeat:Connect(function()
    local c = p.Character
    if c then
        -- Check if effects are still there
        local kl = c:FindFirstChild("KorbloxLeg")
        if not kl then
            applyEffects(c)
        end
    end
end)

print("✅ Headless + Korblox applied (Anti-Reset enabled)!")
