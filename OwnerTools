    Name             = "Owner Tools",
    Icon             = 0,
    LoadingTitle     = "Owner Tools",
    LoadingSubtitle  = "Loading...",
    Theme            = "Default",
    DisableRayfieldPrompts = false,
    DisableBuildWarnings   = false,
    ConfigurationSaving    = { Enabled = false },
    KeySystem = false,
})

-- ============================================================
--  Mobile detection
-- ============================================================
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- ============================================================
--  State
-- ============================================================
local flyActive       = false
local aimbotActive    = false
local highlightActive = false
local highlights      = {}  -- [Player] = Highlight instance
local FLY_SPEED       = 60
local AIMBOT_FOV      = 500
local AIM_SMOOTHING   = 0.25

-- ============================================================
--  HIGHLIGHT
-- ============================================================
local FILL_COLOR    = Color3.fromRGB(255, 50, 50)
local OUTLINE_COLOR = Color3.fromRGB(255, 255, 255)
local FILL_ALPHA    = 0.5

local function createHighlight(char)
    local h = Instance.new("Highlight")
    h.FillColor           = FILL_COLOR
    h.OutlineColor        = OUTLINE_COLOR
    h.FillTransparency    = FILL_ALPHA
    h.OutlineTransparency = 0
    h.Adornee             = char
    h.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent              = char
    return h
end

local function addHighlight(player)
    if player == LocalPlayer then return end
    if highlights[player] then return end
    local char = player.Character
    if not char then return end
    highlights[player] = createHighlight(char)
end

local function removeHighlight(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end

local function refreshHighlights()
    for _, plr in ipairs(Players:GetPlayers()) do
        if highlightActive then addHighlight(plr) else removeHighlight(plr) end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if highlightActive then addHighlight(plr) end
    end)
end)
Players.PlayerRemoving:Connect(removeHighlight)
for _, plr in ipairs(Players:GetPlayers()) do
    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if highlightActive then addHighlight(plr) end
    end)
end

-- ============================================================
--  FLY  —  mobile: thumbstick moves, on-screen Up/Down buttons
--           PC:     WASD moves, Space = Up, LCtrl = Down
-- ============================================================

-- Mobile Up/Down buttons (created only on mobile, shown only while flying)
local flyGui = nil
local mobileUp, mobileDown = false, false

local function buildMobileFlyButtons()
    if flyGui then flyGui:Destroy() end
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local sg = Instance.new("ScreenGui")
    sg.Name = "FlyButtons"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 10
    sg.Parent = pg
    flyGui = sg

    local function makeBtn(label, posX, posY, onDown, onUp)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 80, 0, 80)
        btn.Position = UDim2.new(posX, 0, posY, 0)
        btn.AnchorPoint = Vector2.new(0.5, 0.5)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        btn.BackgroundTransparency = 0.3
        btn.Text = label
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 22
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.Parent = sg
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 16)
        btn.MouseButton1Down:Connect(onDown)
        btn.MouseButton1Up:Connect(onUp)
        -- Touch events for mobile
        btn.TouchLongPress:Connect(function() end) -- prevent long-press menu
        local inputBegan = btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then onDown() end
        end)
        local inputEnded = btn.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.Touch then onUp() end
        end)
        return btn
    end

    -- Bottom-right area, above the jump button
    makeBtn("▲", 0.88, 0.72, function() mobileUp = true end, function() mobileUp = false end)
    makeBtn("▼", 0.88, 0.85, function() mobileDown = true end, function() mobileDown = false end)
end

local function removeMobileFlyButtons()
    if flyGui then flyGui:Destroy() flyGui = nil end
    mobileUp, mobileDown = false, false
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp      = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    flyActive = true
    humanoid.PlatformStand = true

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent   = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.D         = 50
    bg.CFrame    = hrp.CFrame
    bg.Parent    = hrp

    if isMobile then buildMobileFlyButtons() end

    RunService:BindToRenderStep("OwnerFly", Enum.RenderPriority.Input.Value, function()
        if not flyActive then return end
        local cam  = workspace.CurrentCamera
        local move = Vector3.zero

        if isMobile then
            -- Thumbstick sets Humanoid.MoveDirection (world-space unit vector)
            local md = humanoid.MoveDirection
            if md.Magnitude > 0.1 then
                move = Vector3.new(md.X, 0, md.Z)
            end
            if mobileUp   then move += Vector3.yAxis end
            if mobileDown then move -= Vector3.yAxis end
        else
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then move += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end
        end

        bv.Velocity = if move.Magnitude > 0 then move.Unit * FLY_SPEED else Vector3.zero
        bg.CFrame   = cam.CFrame
    end)
end

local function stopFly()
    flyActive = false
    RunService:UnbindFromRenderStep("OwnerFly")
    if isMobile then removeMobileFlyButtons() end

    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in ipairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
            end
        end
    end
end

-- ============================================================
--  AIMBOT  —  custom-camera safe
-- ============================================================
--  1. Rotate HumanoidRootPart to face the target (character-based weapons).
--  2. Override CurrentCamera.CFrame at RenderPriority.Camera + 1, which runs
--     AFTER every camera script — so even a custom camera can't undo it.
--  On mobile the aimbot is always "held" (no button needed); on PC same thing.
-- ============================================================

local function getScreenCenter()
    local vp = workspace.CurrentCamera.ViewportSize
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local function getNearestTarget()
    local cam  = workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local center  = getScreenCenter()
    local best    = nil
    local bestDist = AIMBOT_FOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local pChar = plr.Character
        if not pChar then continue end
        local pHuman = pChar:FindFirstChildOfClass("Humanoid")
        if not pHuman or pHuman.Health <= 0 then continue end

        local aimPart = pChar:FindFirstChild("Head") or pChar:FindFirstChild("HumanoidRootPart")
        if not aimPart then continue end

        local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
        if not onScreen then continue end

        local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist2d < bestDist then
            bestDist = dist2d
            best     = aimPart
        end
    end

    return best
end

local function startAimbot()
    aimbotActive = true

    RunService:BindToRenderStep("OwnerAimbot", Enum.RenderPriority.Camera.Value + 1, function()
        if not aimbotActive then return end

        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local target = getNearestTarget()
        if not target then return end

        local cam       = workspace.CurrentCamera
        local camPos    = cam.CFrame.Position
        local targetPos = target.Position

        -- Rotate character root (flat) so character-based weapons track the target
        local flat = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
        if flat.Magnitude > 0.1 then
            local goal = CFrame.new(hrp.Position, hrp.Position + flat)
            hrp.CFrame = hrp.CFrame:Lerp(goal, 1 - AIM_SMOOTHING)
        end

        -- Override camera after all camera scripts run
        local newCamCF = CFrame.new(camPos, targetPos)
        cam.CFrame     = cam.CFrame:Lerp(newCamCF, 1 - AIM_SMOOTHING)
    end)
end

local function stopAimbot()
    aimbotActive = false
    RunService:UnbindFromRenderStep("OwnerAimbot")
end

